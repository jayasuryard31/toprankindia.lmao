generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(cuid())
  websiteUrl    String   @map("website_url")
  normalizedUrl String   @unique @map("normalized_url")
  websiteName   String   @default("") @map("website_name")
  description   String   @default("")
  logoUrl       String   @default("") @map("logo_url")
  faviconUrl    String   @default("") @map("favicon_url")
  categoryId    Int      @map("category_id")
  currentAmount Int      @default(0) @map("current_amount")
  currency      String   @default("INR")
  paymentStatus String   @default("CREATED") @map("payment_status")
  isActive      Boolean  @default(false) @map("is_active")
  clickCount    Int      @default(0) @map("click_count")
  totalPayments Int      @default(0) @map("total_payments")
  lastRankedAt  DateTime? @map("last_ranked_at")
  plotNumber    String?  @map("plot_number")
  plotDistrict  String?  @map("plot_district")
  plotLng       Float?   @map("plot_lng")
  plotLat       Float?   @map("plot_lat")
  plotTier      String?  @map("plot_tier")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  bids     Bid[]
  clicks   ProductClick[]
  payments Payment[]

  @@index([categoryId])
  @@index([currentAmount(sort: Desc)])
  @@index([createdAt])
  @@index([isActive])
  @@index([paymentStatus])
  @@map("products")
}

model Bid {
  id               String   @id @default(cuid())
  productId        String   @map("product_id")
  amount           Int
  currency         String   @default("INR")
  razorpayOrderId  String   @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")
  status           String   @default("CREATED")
  createdAt        DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([amount(sort: Desc)])
  @@index([status])
  @@index([createdAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("bids")
}

model Payment {
  id                String   @id @default(cuid())
  productId         String   @map("product_id")
  razorpayOrderId   String   @unique @map("razorpay_order_id")
  razorpayPaymentId String?  @unique @map("razorpay_payment_id")
  razorpaySignature String?  @map("razorpay_signature")
  amount            Int
  currency          String   @default("INR")
  status            String   @default("CREATED")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}

model ProductClick {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  ip        String   @default("")
  userAgent String   @default("") @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@map("product_clicks")
}

// One row per page view / product click, used purely for the admin traffic
// dashboard (country breakdown, referrer sources, brand-level traffic).
// `country` is resolved server-side from the request IP via an offline
// geoip database — the IP itself is never sent to a third party.
model VisitEvent {
  id        String   @id @default(cuid())
  path      String   @default("/")
  productId String?  @map("product_id")
  ip        String   @default("")
  country   String   @default("XX") // ISO 3166-1 alpha-2, "XX" = unresolved
  city      String   @default("")
  referrer  String   @default("")
  userAgent String   @default("") @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([country])
  @@index([productId])
  @@map("visit_events")
}

model Billboard {
  id              String    @id @default(cuid())
  billboardNumber Int       @unique @map("billboard_number")
  code            String    @unique
  name            String
  type            String
  rateUSD         Int       @default(20) @map("rate_usd")
  rateINR         Int       @default(1660) @map("rate_inr")
  billingCycle    String    @default("MONTHLY") @map("billing_cycle")

  plotDistrict    String    @default("Central Core") @map("plot_district")
  elevation       Float     @default(8)
  width           Float     @default(14)
  height          Float     @default(7.5)
  isGantry        Boolean   @default(false) @map("is_gantry")
  // How the slot is physically carried: facade | folded | gantry | pole.
  // Times Square inventory is facade/folded — bolted to the buildings.
  mount           String    @default("pole")
  orientation     String    @default("landscape")

  isOccupied      Boolean   @default(false) @map("is_occupied")
  paymentStatus   String    @default("VACANT") @map("payment_status")
  activeUntil     DateTime? @map("active_until")
  bookedMonths    Int       @default(1) @map("booked_months")
  totalPaid       Int       @default(0) @map("total_paid")
  lastPaidAt      DateTime? @map("last_paid_at")

  brandName       String    @default("") @map("brand_name")
  websiteUrl      String    @default("") @map("website_url")
  tagline         String    @default("")
  description     String    @default("")
  logoUrl         String    @default("") @map("logo_url")
  faviconUrl      String    @default("") @map("favicon_url")
  categoryName    String    @default("Featured Sponsor") @map("category_name")
  color           String    @default("#F05A38")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  payments        BillboardPayment[]

  @@index([billboardNumber])
  @@index([code])
  @@index([isOccupied])
  @@index([paymentStatus])
  @@map("billboards")
}

model BillboardPayment {
  id                String    @id @default(cuid())
  billboardId       String    @map("billboard_id")
  billboardNumber   Int       @map("billboard_number")
  razorpayOrderId   String    @unique @map("razorpay_order_id")
  razorpayPaymentId String?   @unique @map("razorpay_payment_id")
  razorpaySignature String?   @map("razorpay_signature")
  amountUSD         Int       @map("amount_usd")
  amountINR         Int       @map("amount_inr")
  months            Int       @default(1)
  status            String    @default("CREATED")

  websiteUrl        String    @map("website_url")
  brandName         String    @map("brand_name")
  tagline           String    @default("")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  billboard         Billboard @relation(fields: [billboardId], references: [id])

  @@index([billboardId])
  @@index([billboardNumber])
  @@index([status])
  @@index([razorpayOrderId])
  @@map("billboard_payments")
}
